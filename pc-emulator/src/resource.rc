#include <winver.h>

101 ICON "../assets/vicebox.ico"
1 24 "app.manifest"
201 RCDATA "../assets/video/gta6_intro.mp4"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,8,0,0
 PRODUCTVERSION 2,8,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "ViceBox Hypervisor"
            VALUE "FileDescription",  "VICEBOX X - Embedded WebGPU Emulator (PS5, Xbox & ViceOS Neo · Experimental GTA 6)"
            VALUE "FileVersion",      "2.8.0.0"
            VALUE "InternalName",     "ViceBox-GTA6-Emulator"
            VALUE "OriginalFilename", "ViceBox-GTA6-Emulator.exe"
            VALUE "ProductName",      "VICEBOX X"
            VALUE "ProductVersion",   "2.8.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
