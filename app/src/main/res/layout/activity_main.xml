<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_obsidian">

    <!-- Ambient PS5 cobalt light-wave wallpaper -->
    <ImageView
        android:id="@+id/bgArt"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_ps5_launcher"
        android:contentDescription="@null" />

    <!-- Cinematic dark scrim -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_scrim_launcher" />

    <!-- Main Content Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="40dp"
            android:paddingBottom="24dp">

            <!-- Top Bar: Device Telemetry Pill + Discreet Info Button (i) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <View
                        android:id="@+id/statusDot"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginEnd="8dp"
                        android:background="#38BDF8" />

                    <TextView
                        android:id="@+id/tvDeviceSpecs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"
                        android:text="DETECTING HARDWARE..."
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Small discreet Info (i) button hiding the underlying engine disclosure -->
                <TextView
                    android:id="@+id/btnInfo"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_info_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:text="i"
                    android:textColor="#CBE3FF"
                    android:textSize="15sp"
                    android:textStyle="bold|italic" />
            </LinearLayout>

            <!-- Hero PS5 Crest & Branding -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="18dp"
                android:paddingBottom="18dp">

                <ImageView
                    android:id="@+id/ivCrest"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:elevation="12dp"
                    android:src="@drawable/ic_ps5_crest"
                    android:contentDescription="@string/app_name" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-light"
                    android:letterSpacing="0.24"
                    android:shadowColor="#B00070D1"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="16"
                    android:text="@string/launcher_brand"
                    android:textColor="@color/text_primary"
                    android:textSize="36sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.18"
                    android:text="@string/launcher_subtitle"
                    android:textColor="@color/ps5_light"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <!-- Frosted PS5 Pre-Boot Configuration Deck -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:elevation="16dp"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 1. Low-End Phone Mode Toggle Card -->
                <LinearLayout
                    android:id="@+id/lowEndCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_toggle_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-medium"
                                    android:text="@string/low_end_title"
                                    android:textColor="@color/text_primary"
                                    android:textSize="14.5sp" />

                                <TextView
                                    android:id="@+id/tvModeBadge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:background="@drawable/bg_badge_std"
                                    android:fontFamily="sans-serif-black"
                                    android:letterSpacing="0.06"
                                    android:paddingStart="7dp"
                                    android:paddingEnd="7dp"
                                    android:paddingTop="2dp"
                                    android:paddingBottom="2dp"
                                    android:text="STANDARD"
                                    android:textColor="@color/ps5_cyan"
                                    android:textSize="9.5sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvLowEndDesc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:lineSpacingExtra="1dp"
                                android:text="@string/low_end_desc_off"
                                android:textColor="@color/text_secondary"
                                android:textSize="11.5sp" />
                        </LinearLayout>

                        <com.ps5.mobile.ui.PremiumToggleSwitch
                            android:id="@+id/toggleLowEnd"
                            android:layout_width="58dp"
                            android:layout_height="32dp" />
                    </LinearLayout>

                    <!-- Resource Load Meter -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.08"
                            android:text="SYSTEM LOAD"
                            android:textColor="@color/text_muted"
                            android:textSize="9.5sp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tvProfileMeta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="720p · 60 FPS"
                            android:textColor="@color/text_secondary"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <com.ps5.mobile.ui.ResourceLoadBarView
                        android:id="@+id/loadBar"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="5dp" />
                </LinearLayout>

                <!-- 2. Graphics Quality Override (Fixes playgta5.com lower graphics floor) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:background="@drawable/bg_toggle_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="Graphics Quality"
                            android:textColor="@color/text_primary"
                            android:textSize="13.5sp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tvGraphicsHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="ULTRA LOW · NO SHADOWS"
                            android:textColor="@color/ps5_cyan"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/graphicsPresetRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:orientation="horizontal" />
                </LinearLayout>

                <!-- 3. Render Distance Numeric Control (Default = Engine Default) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:background="@drawable/bg_toggle_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="Render Distance"
                                android:textColor="@color/text_primary"
                                android:textSize="13.5sp" />

                            <TextView
                                android:id="@+id/tvRenderDistDesc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Default (Engine Default) · Lower = less loads nearby"
                                android:textColor="@color/text_secondary"
                                android:textSize="10.5sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/btnRenderDistNum"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_std"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="monospace"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:text="DEFAULT"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnRenderDistReset"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:padding="5dp"
                            android:text="RESET"
                            android:textColor="@color/ps5_light"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seekRenderDist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:max="100"
                        android:progress="50"
                        android:progressTint="@color/ps5_cyan"
                        android:thumbTint="#FFFFFF" />
                </LinearLayout>

                <!-- 4. Hero PS5 Launch Button -->
                <LinearLayout
                    android:id="@+id/btnLaunch"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_launch_btn"
                    android:clickable="true"
                    android:elevation="10dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.14"
                        android:text="@string/launch_button"
                        android:textColor="#FFFFFF"
                        android:textSize="15.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/launch_sub"
                        android:textColor="#D6ECFF"
                        android:textSize="10.5sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
