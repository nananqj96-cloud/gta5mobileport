<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_obsidian">

    <!-- Ambient PS5 cobalt light-wave wallpaper -->
    <ImageView
        android:id="@+id/bgArt"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_ps5_launcher"
        android:contentDescription="@null" />

    <!-- Cinematic dark scrim -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_scrim_launcher" />

    <!-- Main Content Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="34dp"
            android:paddingBottom="22dp">

            <!-- Top Bar: Live Hardware RAM/Free Telemetry Pill + Discreet Info Button (i) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_status_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="11dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <View
                        android:id="@+id/statusDot"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginEnd="7dp"
                        android:background="#34D399" />

                    <TextView
                        android:id="@+id/tvDeviceSpecs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.04"
                        android:maxLines="1"
                        android:text="DETECTING HARDWARE..."
                        android:textColor="@color/text_secondary"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <!-- Small discreet Info (i) button -->
                <TextView
                    android:id="@+id/btnInfo"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_info_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:text="i"
                    android:textColor="#CBE3FF"
                    android:textSize="15sp"
                    android:textStyle="bold|italic" />
            </LinearLayout>

            <!-- Compact Hero PS5 Crest & v3.0 Branding -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <ImageView
                    android:id="@+id/ivCrest"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:elevation="12dp"
                    android:src="@drawable/ic_ps5_crest"
                    android:contentDescription="@string/app_name" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-light"
                    android:letterSpacing="0.22"
                    android:shadowColor="#B00070D1"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="16"
                    android:text="@string/launcher_brand"
                    android:textColor="@color/text_primary"
                    android:textSize="31sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.16"
                    android:text="@string/launcher_subtitle"
                    android:textColor="#6EE7B7"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Frosted PS5 v3.0 Configuration Deck -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:elevation="16dp"
                android:orientation="vertical"
                android:padding="15dp">

                <!-- 1. HERO: ULTRA OPTIMIZE MODE CARD (FORCES GTA V ON LOW-VRAM / LOW-RAM PHONES) -->
                <LinearLayout
                    android:id="@+id/ultraCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_ultra_card_active"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-black"
                                    android:text="@string/ultra_title"
                                    android:textColor="#FFFFFF"
                                    android:textSize="14.5sp" />

                                <TextView
                                    android:id="@+id/tvUltraBadge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="7dp"
                                    android:background="@drawable/bg_badge_ultra"
                                    android:fontFamily="sans-serif-black"
                                    android:letterSpacing="0.06"
                                    android:paddingStart="7dp"
                                    android:paddingEnd="7dp"
                                    android:paddingTop="2dp"
                                    android:paddingBottom="2dp"
                                    android:text="ULTRA 360p"
                                    android:textColor="#34D399"
                                    android:textSize="9.5sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvUltraDesc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:lineSpacingExtra="1dp"
                                android:text="@string/ultra_desc_balanced"
                                android:textColor="#CBD5E1"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <com.ps5.mobile.ui.PremiumToggleSwitch
                            android:id="@+id/toggleUltra"
                            android:layout_width="58dp"
                            android:layout_height="32dp" />
                    </LinearLayout>

                    <!-- Ultra Tier Selector Row: ULTRA 360p vs EXTREME 270p -->
                    <LinearLayout
                        android:id="@+id/ultraTierRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnUltraBalanced"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-black"
                            android:gravity="center"
                            android:paddingTop="7dp"
                            android:paddingBottom="7dp"
                            android:text="⚡ ULTRA 360p (4GB)"
                            android:textColor="#FFFFFF"
                            android:textSize="10.5sp" />

                        <TextView
                            android:id="@+id/btnUltraExtreme"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="7dp"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-black"
                            android:gravity="center"
                            android:paddingTop="7dp"
                            android:paddingBottom="7dp"
                            android:text="🔥 EXTREME 270p (2-3GB)"
                            android:textColor="#CBD5E1"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <!-- Concrete VRAM / RAM Savings Telemetry Strip -->
                    <TextView
                        android:id="@+id/tvUltraSavings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="monospace"
                        android:text="BC Mip-Drop ≤256px · Ring 2MB · Arena 4MB · IO 32MB · ~75% VRAM saved"
                        android:textColor="#6EE7B7"
                        android:textSize="9.8sp" />

                    <!-- Resource Load Meter -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.08"
                            android:text="VRAM / RAM LOAD"
                            android:textColor="@color/text_muted"
                            android:textSize="9sp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tvProfileMeta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="ULTRA 360p · 30 FPS"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <com.ps5.mobile.ui.ResourceLoadBarView
                        android:id="@+id/loadBar"
                        android:layout_width="match_parent"
                        android:layout_height="7dp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- 2. Compact Row: Skip PS5 Home (Direct Boot) + Low-End Toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:orientation="horizontal">

                    <!-- Skip PS5 Home Toggle Pill -->
                    <LinearLayout
                        android:id="@+id/skipHomeCard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_toggle_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="Skip PS5 Home"
                                android:textColor="@color/text_primary"
                                android:textSize="11.5sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Saves ~150MB RAM"
                                android:textColor="#6EE7B7"
                                android:textSize="9.5sp" />
                        </LinearLayout>

                        <com.ps5.mobile.ui.PremiumToggleSwitch
                            android:id="@+id/toggleSkipHome"
                            android:layout_width="46dp"
                            android:layout_height="26dp" />
                    </LinearLayout>

                    <!-- Low-End Mode Toggle Pill -->
                    <LinearLayout
                        android:id="@+id/lowEndCard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_toggle_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="Low-End Cap"
                                android:textColor="@color/text_primary"
                                android:textSize="11.5sp" />

                            <TextView
                                android:id="@+id/tvModeBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="30 FPS · 2 Cores"
                                android:textColor="@color/ps5_cyan"
                                android:textSize="9.5sp" />
                        </LinearLayout>

                        <com.ps5.mobile.ui.PremiumToggleSwitch
                            android:id="@+id/toggleLowEnd"
                            android:layout_width="46dp"
                            android:layout_height="26dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 3. Graphics Quality Override -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:background="@drawable/bg_toggle_card"
                    android:orientation="vertical"
                    android:padding="11dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="Graphics Quality"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tvGraphicsHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="POTATO · ULTRA OPT"
                            android:textColor="@color/ps5_cyan"
                            android:textSize="9.8sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/graphicsPresetRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal" />
                </LinearLayout>

                <!-- 4. Render Distance Numeric Control -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:background="@drawable/bg_toggle_card"
                    android:orientation="vertical"
                    android:padding="11dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="Render Distance"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvRenderDistDesc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ultra-Near · Minimal nearby streaming"
                                android:textColor="@color/text_secondary"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/btnRenderDistNum"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_std"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="monospace"
                            android:paddingStart="9dp"
                            android:paddingEnd="9dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:text="DEFAULT"
                            android:textColor="@color/text_primary"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnRenderDistReset"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:padding="4dp"
                            android:text="RESET"
                            android:textColor="@color/ps5_light"
                            android:textSize="9.5sp" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seekRenderDist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:max="100"
                        android:progress="18"
                        android:progressTint="@color/ps5_cyan"
                        android:thumbTint="#FFFFFF" />
                </LinearLayout>

                <!-- 5. Hero Launch Buttons -->
                <LinearLayout
                    android:id="@+id/btnLaunch"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_launch_btn"
                    android:clickable="true"
                    android:elevation="10dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvLaunchTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.14"
                        android:text="@string/launch_button"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvLaunchSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/launch_sub"
                        android:textColor="#D6ECFF"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Instant 1-Tap Direct Boot GTA V CTA (Bypasses PS5 Home for Lowest RAM) -->
                <LinearLayout
                    android:id="@+id/btnDirectBoot"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_launch_ultra_btn"
                    android:clickable="true"
                    android:elevation="6dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.09"
                        android:text="@string/launch_direct_button"
                        android:textColor="#FFFFFF"
                        android:textSize="12.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/launch_direct_sub"
                        android:textColor="#D1FAE5"
                        android:textSize="9.5sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
